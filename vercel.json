{
  "buildCommand": "npm run build",
  "functions": {
    "src/app/api/cron/sync-project-data/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync-project-data",
      "schedule": "0 */12 * * *"
    },
    {
      "path": "/api/cron/sync-project-data?only=dashboard",
      "schedule": "*/10 4-6 * * *"
    }
  ]
}
